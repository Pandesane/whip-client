{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug SvelteKit (Chrome)",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:5174/asterisk_new",
      "webRoot": "${workspaceFolder}",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "/src/*": "${workspaceFolder}/src/*"
      }
    }
  ]
}